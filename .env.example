# MONGODB_URI: Connection string for MongoDB used by Payload CMS.
# Atlas example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/modexa-digital?retryWrites=true&w=majority
# Local example: mongodb://127.0.0.1:27017/modexa-digital
MONGODB_URI=

# PAYLOAD_SECRET: Cryptographic secret used by Payload CMS to sign auth cookies/JWTs.
# Generate a strong random 32+ character string before deploying or starting /admin.
PAYLOAD_SECRET=

# NEXT_PUBLIC_SERVER_URL: Public base URL of this application (no trailing slash).
# Example local: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=

# APP_URL: Runtime URL injected by the hosting platform.
APP_URL="MY_APP_URL"

# Email Notifications (Server-side only via Resend)
# EMAIL_FROM: Verified sender address, e.g. Modexa Digital <noreply@modexadigital.com>
EMAIL_FROM=
# ADMIN_NOTIFICATION_EMAIL: Agency administrator inbox for new enquiry alerts
ADMIN_NOTIFICATION_EMAIL=
# EMAIL_API_KEY: Server-side Resend API key (re_...)
EMAIL_API_KEY=

# GEMINI_API_KEY: Server-side Gemini API key (if server AI routes are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
