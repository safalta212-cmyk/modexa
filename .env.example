# ==============================================================================
# MODX 2.0 — Modexa Digital Agency Environment Variables
# Copy these variables into Vercel -> Project Settings -> Environment Variables
# (Production & Preview as needed). Never commit real secrets to GitHub.
# ==============================================================================

# MONGODB_URI: Production MongoDB Atlas connection string used by Payload CMS.
# Atlas example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/modexa-digital?retryWrites=true&w=majority&appName=ModexaCluster
# Local example: mongodb://127.0.0.1:27017/modexa-digital
MONGODB_URI=

# PAYLOAD_SECRET: Cryptographic secret used by Payload CMS to sign auth cookies/JWTs.
# Must be at least 32 random characters in production (never reuse dev placeholders).
PAYLOAD_SECRET=

# NEXT_PUBLIC_SERVER_URL: Public canonical base URL of this application (no trailing slash).
# Example production: https://modexadigital.com (or https://your-project.vercel.app)
# Example local: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=

# BLOB_READ_WRITE_TOKEN: Vercel Blob store token for persistent production media uploads.
# Automatically created by Vercel when you connect a Blob Store to your project.
# When unset locally, media uploads fall back to local ./media disk storage.
BLOB_READ_WRITE_TOKEN=

# APP_URL: Runtime URL injected by the hosting platform.
APP_URL="MY_APP_URL"

# Email Notifications (Server-side only via Resend)
# EMAIL_FROM: Verified sender address, e.g. Modexa Digital <noreply@modexadigital.com>
EMAIL_FROM=
# ADMIN_NOTIFICATION_EMAIL: Agency administrator inbox for new enquiry alerts
ADMIN_NOTIFICATION_EMAIL=
# EMAIL_API_KEY: Server-side Resend API key (re_...)
EMAIL_API_KEY=

# GEMINI_API_KEY: Server-side Gemini API key (if server AI routes are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
